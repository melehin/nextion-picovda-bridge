# nextion-picovda scene (authoring DSL)
# Target: 1280x720 on VideoXGA timings
# Layout: COLOR side pillars + center FTEXT 640 (keeps scanline render cheap)

meta
  size 1280 720
  font 1 8x16

# ---- page 0: main ----
page main 0 bg=#001830

  plan
    strip 64
      seg color 1280 bg=#102848
    strip 32
      seg color 320 bg=#102848
      seg ftext 640 font=1 bg=#102848 buf=ftext0
      seg color 320 bg=#102848
    strip 592
      seg color 320 bg=#001830
      seg ftext 640 font=1 bg=#001830 buf=ftext1
      seg color 320 bg=#001830
    strip 32
      seg color 1280 bg=#0a1428

  # text x is absolute; center band starts at x=320
  text  t0  x=336 y=72  font=1 color=#ffffff "PicoVGA Bridge 1280x720"
  text  t1  x=336 y=112 font=1 color=#a0c0ff "RPM"
  num   n0  x=400 y=112 font=1 color=#ffff00 val=0 digits=4
  text  t2  x=336 y=144 font=1 color=#a0c0ff "TEMP"
  num   n1  x=400 y=144 font=1 color=#00ff80 val=25 digits=3
  text  t3  x=336 y=176 font=1 color=#80ffc0 "STATUS"
  text  t4  x=440 y=176 font=1 color=#ffffff "OK"
  text  t5  x=336 y=208 font=1 color=#6080a0 "center FTEXT + COLOR sides"

# ---- page 1: settings ----
page settings 1 bg=#180018

  plan
    strip 48
      seg color 1280 bg=#301030
    strip 32
      seg color 320 bg=#301030
      seg ftext 640 font=1 bg=#301030 buf=ftext0
      seg color 320 bg=#301030
    strip 640
      seg color 320 bg=#180018
      seg ftext 640 font=1 bg=#180018 buf=ftext1
      seg color 320 bg=#180018

  text  t0  x=336 y=56  font=1 color=#ffffff "Settings"
  text  t1  x=336 y=96  font=1 color=#c080ff "baud"
  num   n0  x=416 y=96  font=1 color=#ffff00 val=115200 digits=6
  text  t2  x=336 y=128 font=1 color=#a080c0 "page main / page settings"
